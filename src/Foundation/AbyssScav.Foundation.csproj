<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>AbyssScav.Foundation</AssemblyName>
    <RootNamespace>AbyssScav.Foundation</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Engine-independent only: this project must never reference GodotSharp. -->
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="lang/*.json" />
  </ItemGroup>

</Project>
